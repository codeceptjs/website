---
// Landing-page announcement pill. Driven by src/config/announcement.ts —
// renders nothing when the announcement is disabled there.
import { announcement } from '../config/announcement';
---

{
    announcement.enabled && (
        <div class="cc-announce-row">
            <a href={announcement.link} class="cc-announce">
                {announcement.tag && <span class="cc-announce-tag">{announcement.tag}</span>}
                <span class="cc-announce-text">{announcement.text}</span>
                <span class="cc-announce-arrow" aria-hidden="true">&rarr;</span>
            </a>
        </div>
    )
}

<style>
    .cc-announce-row {
        margin-bottom: 1.75rem;
        animation: cc-announce-in 0.6s ease-out both;
    }
    .cc-announce {
        position: relative;
        display: flex;
        width: 100%;
        box-sizing: border-box;
        align-items: center;
        justify-content: flex-start;
        gap: 0.5rem;
        padding: 0.625rem 1.25rem;
        border-radius: 0.75rem;
        border: 1px solid color-mix(in srgb, var(--codecept-accent, #F2A900) 35%, transparent);
        background: color-mix(in srgb, var(--codecept-accent, #F2A900) 9%, transparent);
        font-size: 0.875rem;
        font-weight: 500;
        line-height: 1.3;
        color: var(--sl-color-text);
        text-decoration: none;
        transition: border-color 0.15s ease, background 0.15s ease;
    }
    .cc-announce:hover {
        border-color: color-mix(in srgb, var(--codecept-accent, #F2A900) 65%, transparent);
        background: color-mix(in srgb, var(--codecept-accent, #F2A900) 16%, transparent);
    }
    .cc-announce-tag {
        flex-shrink: 0;
        padding: 0.125rem 0.5rem;
        border-radius: 999px;
        background: var(--codecept-accent, #F2A900);
        color: #1f1500;
        font-size: 0.6875rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }
    .cc-announce-text {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        white-space: nowrap;
    }
    .cc-announce-arrow {
        flex-shrink: 0;
        margin-left: auto;
        color: var(--codecept-accent, #F2A900);
        transition: transform 0.15s ease;
    }
    .cc-announce:hover .cc-announce-arrow {
        transform: translateX(3px);
    }
    @keyframes cc-announce-in {
        from { opacity: 0; transform: translateY(-6px); }
        to { opacity: 1; transform: none; }
    }
    @media (prefers-reduced-motion: reduce) {
        .cc-announce-row { animation: none; }
    }
</style>
