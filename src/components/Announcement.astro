---
// Landing-page announcement pill. Driven by src/config/announcement.ts —
// renders nothing when the announcement is disabled there.
import { announcement } from '../config/announcement';
---

{
    announcement.enabled && (
        <div class="cc-announce-row">
            <a href={announcement.link} class="cc-announce">
                <span class="cc-announce-text">{announcement.text}</span>
            </a>
        </div>
    )
}

<style>
    .cc-announce-row {
        --cc-announce: #9810fa;
        margin-bottom: 1.75rem;
        animation: cc-announce-in 0.6s ease-out both;
    }
    .cc-announce {
        position: relative;
        display: flex;
        width: 100%;
        box-sizing: border-box;
        align-items: center;
        justify-content: flex-start;
        gap: 0.5rem;
        padding: 0.6875rem 1rem;
        border-radius: 5px;
        border: 3px dotted color-mix(in srgb, var(--cc-announce) 34%, transparent);
        background: color-mix(in srgb, var(--cc-announce) 3%, transparent);
        font-size: 0.9rem;
        font-weight: bold;
        line-height: 1.3;
        color: var(--cc-announce);
        text-decoration: none;
        transition: border-color 0.15s ease, background 0.15s ease;
    }
    .cc-announce:hover {
        border-color: color-mix(in srgb, var(--cc-announce) 55%, transparent);
        background: color-mix(in srgb, var(--cc-announce) 7%, transparent);
    }
    .cc-announce-text {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        white-space: nowrap;
    }
    @keyframes cc-announce-in {
        from { opacity: 0; transform: translateY(-6px); }
        to { opacity: 1; transform: none; }
    }
    @media (prefers-reduced-motion: reduce) {
        .cc-announce-row { animation: none; }
    }
</style>
