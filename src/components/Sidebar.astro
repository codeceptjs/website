---
// Wraps the sidebar-topics Sidebar (our components override replaces the plugin's).
import TopicsSidebar from 'starlight-sidebar-topics/overrides/Sidebar.astro';
import BlogAbout from './BlogAbout.astro';

const slug = Astro.locals.starlightRoute.entry.slug;
const isBlog = slug === 'blog' || slug.startsWith('blog/');
---

<TopicsSidebar><slot /></TopicsSidebar>
{isBlog && (
	<div class="blog-about-left">
		<BlogAbout />
	</div>
)}

<style>
	.blog-about-left {
		display: none;
	}
	@media (min-width: 50rem) {
		.blog-about-left {
			display: block;
		}
	}
</style>
