---
import StarlightHead from '@astrojs/starlight/components/Head.astro';
import VtbotStarlight from 'astro-vtbot/components/starlight/Base.astro';
import type {
    Article,
    Organization,
    WebSite,
    WithContext
} from 'schema-dts';

const { title, description } = Astro.locals.starlightRoute.entry.data;

// Absolute URLs for social cards and structured data.
const ogImage = new URL('/og-image.png', Astro.site).href;
const brandLogo = new URL('/favicon-512.png', Astro.site).href;

const website: WithContext<WebSite> = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': Astro.locals.starlightRoute.id,
    description,
    image: {
        '@type': 'ImageObject',
        url: ogImage
    },
    inLanguage: Astro.locals.starlightRoute.lang,
    name: Astro.locals.starlightRoute.siteTitle,
    url: Astro.url.href,
    "sameAs": [
        "https://codecept.io/",
        "https://twitter.com/codeceptjs",
        "https://codeceptjs.slack.com/join/shared_invite/zt-1dkxkju78-9aThX6G2~iDkLwhuRsPVsg",
        "https://codecept.discourse.group/",
        "https://stackoverflow.com/questions/tagged/codeceptjs",
        "https://github.com/codeceptjs/CodeceptJS/discussions",
        "https://github.com/codeceptjs/CodeceptJS",
    ],
}

const organization: WithContext<Organization> = {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    image: {
        '@type': 'ImageObject',
        url: ogImage
    },
    url: Astro.url.href,
    "sameAs": [
        "https://codecept.io/",
        "https://twitter.com/codeceptjs",
        "https://codeceptjs.slack.com/join/shared_invite/zt-1dkxkju78-9aThX6G2~iDkLwhuRsPVsg",
        "https://codecept.discourse.group/",
        "https://stackoverflow.com/questions/tagged/codeceptjs",
        "https://github.com/codeceptjs/CodeceptJS/discussions",
        "https://github.com/codeceptjs/CodeceptJS",
    ],
    logo: {
        '@type': 'ImageObject',
        url: brandLogo
    },
    name: Astro.locals.starlightRoute.siteTitle,
    description,
    '@id': Astro.locals.starlightRoute.id,
}

const article: WithContext<Article> = {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    url: Astro.url,
    image: {
        '@type': 'ImageObject',
        url: ogImage
    },
    inLanguage: Astro.locals.starlightRoute.lang,
}

---

<VtbotStarlight>
    <StarlightHead><slot /></StarlightHead>
</VtbotStarlight>

{/* Favicons & PWA — Starlight emits the SVG favicon; these add the fallbacks. */}
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#1a1d28" media="(prefers-color-scheme: dark)" />

{/* Social preview image (Open Graph / Twitter card) */}
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="CodeceptJS — Supercharged End 2 End Testing" />
<meta name="twitter:image" content={ogImage} />

{
    [website, organization, article].map((data) =>
        <script is:inline set:html={JSON.stringify(data)} type='application/ld+json' />
    )
}
