---
import Default from '@astrojs/starlight/components/Footer.astro';

// The branded site footer is rendered full-width by PageFrame.astro. This slot
// keeps only Starlight's in-content footer (pagination, edit link, last updated)
// on documentation pages.
const isHomepage = Astro.locals.starlightRoute.id === '';
---

{!isHomepage && (
    <Default>
        <slot />
    </Default>
)}
